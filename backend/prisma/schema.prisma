// AMAR Studios - Prisma schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ADMIN
// ============================================================
model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// CATEGORY
// ============================================================
model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

// ============================================================
// PRODUCT
// ============================================================
model Product {
  id            String           @id @default(uuid())
  name          String
  slug          String           @unique
  description   String           @db.Text
  price         Decimal          @db.Decimal(10, 2)
  promoPrice    Decimal?         @db.Decimal(10, 2)
  active        Boolean          @default(true)
  featured      Boolean          @default(false)
  isNew         Boolean          @default(true)
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  orderItems    OrderItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([categoryId])
  @@index([active])
  @@index([featured])
}

// ============================================================
// PRODUCT IMAGE
// ============================================================
model ProductImage {
  id        String   @id @default(uuid())
  url       String
  isMain    Boolean  @default(false)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

// ============================================================
// PRODUCT VARIANT (size + color + stock)
// ============================================================
model ProductVariant {
  id        String      @id @default(uuid())
  size      String
  color     String
  colorHex  String?
  stock     Int         @default(0)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([productId, size, color])
  @@index([productId])
}

// ============================================================
// ORDER (no client account)
// ============================================================
enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  customerName  String
  phone         String
  email         String?
  address       String
  city          String
  notes         String?     @db.Text
  total         Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([phone])
  @@index([city])
}

// ============================================================
// ORDER ITEM
// ============================================================
model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  productName String
  size        String
  color       String
  unitPrice   Decimal         @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal         @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}
